APP_ENV=local
APP_PORT=8080
GRPC_PORT=9090
LOG_JSON=true
LOG_DEBUG=true

# Shared MySQL database with the Laravel portal_produk_dbklik app
# (do NOT put real credentials here):
DB_DRIVER=mysql
DB_DSN=user:pass@tcp(127.0.0.1:3306)/portal_produk_dbklik?parseTime=true&loc=Local

STORAGE_PATH=storage

# Kompetitor module — mirrors config/scraping.php on the Laravel side.
# Our own store's row in `kompetitors`; 0 hides the Harga Tayang column.
DBKLIK_KOMPETITOR_ID=0
# TF-IDF cosine cutoff for accepting a product match.
KOMPETITOR_MATCH_THRESHOLD=0.6
# How old a kompetitor's batch may be and still be used as a fallback.
KOMPETITOR_MAX_STALE_DAYS=3
